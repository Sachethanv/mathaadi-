# Sarvam AI key (https://dashboard.sarvam.ai). Leave empty to run in demo mode.
SARVAM_API_KEY=

# Optional overrides
# SARVAM_STT_MODEL=saaras:v3      # v3 supports verbatim mode; try saaras:v4 for keyterms
# SARVAM_STT_MODE=verbatim
# SARVAM_LLM_MODEL=sarvam-105b    # or sarvam-105b-conversations for lower latency
# SARVAM_TTS_MODEL=bulbul:v3
# TURNS_PER_HOUR=30               # per-IP limit so visitors can't drain credits
# DEMO_MODE=1                     # force scripted demo mode even with a key
